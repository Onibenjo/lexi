# OpenRouter key (https://openrouter.ai/keys). Server-side only.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id. Defaults to anthropic/claude-haiku-4.5
OPENROUTER_MODEL=
# Shared passcode you and your friend type into Settings → AI feedback
APP_PASSCODE=
# Sync across devices: Upstash Redis. Connecting Upstash from the Vercel Marketplace sets
# these automatically (KV_REST_API_URL / KV_REST_API_TOKEN). Locally, without them,
# `npm run dev` keeps sync data in memory until the server restarts.
KV_REST_API_URL=
KV_REST_API_TOKEN=
